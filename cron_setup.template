# Libo Insights — Cron template (do not install this file directly)
# Generated by: ./cron_manager.sh install

LIBO_INSIGHTS_ROOT=__LIBO_INSIGHTS_ROOT__

# Realtime — forex + energy once daily at 07:00 UTC
0 7 * * * $LIBO_INSIGHTS_ROOT/cron_realtime.sh

# Weekly — DWS dam levels every Monday 06:00 UTC
0 6 * * 1 $LIBO_INSIGHTS_ROOT/cron_weekly.sh

# Monthly — finance, property, employment, health on 1st 05:00 UTC
0 5 1 * * $LIBO_INSIGHTS_ROOT/cron_monthly.sh

# Quarterly — all 10 topics (Jan, Apr, Jul, Oct) 04:00 UTC
0 4 1 1,4,7,10 * $LIBO_INSIGHTS_ROOT/cron_quarterly.sh

# Log cleanup — delete logs older than 30 days (daily 02:00 UTC)
0 2 * * * find $LIBO_INSIGHTS_ROOT/logs -name "*.log" -mtime +30 -delete
