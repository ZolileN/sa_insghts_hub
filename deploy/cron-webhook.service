[Unit]
Description=Libo Insights scraper webhook (cron-job.org)
After=network.target

[Service]
Type=simple
User=libo
WorkingDirectory=/opt/libo-insights
EnvironmentFile=/opt/libo-insights/.env
ExecStart=/opt/libo-insights/.venv/bin/python3 /opt/libo-insights/webhook_server.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
